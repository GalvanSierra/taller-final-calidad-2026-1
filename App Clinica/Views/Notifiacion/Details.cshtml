@model App_Clinica.Models.Notifiacion

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Details</title>
</head>
<body>

<div>
    <h4>Notifiacion</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaEnvio)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaEnvio)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Mensaje)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Mensaje)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Enviada)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Enviada)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IdCitaNavigation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IdCitaNavigation.IdCita)
        </dd>
    </dl>
</div>
<div>
        <form asp-controller="Notificacion" asp-action="Index" method="get">
            <div class="form-group">
                <input type="submit" value="Regresar" class="btn btn-success" />
            </div>
        </form>
</div>
</body>
</html>
