@model App_Clinica.Models.CitaMedica
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Agendar Cita — App Clínica</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        border: "hsl(240 5.9% 90%)",
                        background: "hsl(20 14.3% 95.5%)",
                        foreground: "hsl(240 10% 3.9%)",
                        primary: { DEFAULT: "hsl(240 5.9% 10%)", foreground: "hsl(0 0% 98%)" },
                        muted: { DEFAULT: "hsl(240 4.8% 95.9%)", foreground: "hsl(240 3.8% 46.1%)" },
                        card: { DEFAULT: "hsl(0 0% 100%)", foreground: "hsl(240 10% 3.9%)" },
                        destructive: { DEFAULT: "hsl(0 84.2% 60.2%)", foreground: "hsl(0 0% 98%)" },
                    },
                    borderRadius: { lg: "0.5rem", xl: "0.75rem" },
                }
            }
        }
    </script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif; }
        .btn-ghost-nav {
            display: inline-flex; align-items: center; justify-content: center;
            padding: 0.5rem 0.75rem; font-size: 0.8125rem; font-weight: 500;
            color: hsl(240 3.8% 46.1%); background: transparent; border: none;
            border-radius: 0.375rem; cursor: pointer;
            transition: background-color 0.15s ease, color 0.15s ease; text-decoration: none;
        }
        .btn-ghost-nav:hover { background-color: hsl(240 4.8% 95.9%); color: hsl(240 10% 3.9%); }
        .form-input {
            width: 100%; padding: 0.5rem 0.75rem; font-size: 0.875rem; line-height: 1.5;
            color: hsl(240 10% 3.9%); background-color: hsl(0 0% 100%);
            border: 1px solid hsl(240 5.9% 90%); border-radius: 0.5rem;
            transition: border-color 0.15s ease, box-shadow 0.15s ease; outline: none;
        }
        .form-input:focus { border-color: hsl(240 5.9% 10%); box-shadow: 0 0 0 2px hsl(240 5.9% 10% / 0.1); }
        .form-input::placeholder { color: hsl(240 3.8% 61%); }
        .form-select {
            width: 100%; padding: 0.5rem 0.75rem; font-size: 0.875rem; line-height: 1.5;
            color: hsl(240 10% 3.9%); background-color: hsl(0 0% 100%);
            border: 1px solid hsl(240 5.9% 90%); border-radius: 0.5rem;
            transition: border-color 0.15s ease, box-shadow 0.15s ease; outline: none;
            appearance: none;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
            background-position: right 0.5rem center; background-repeat: no-repeat;
            background-size: 1.5em 1.5em; padding-right: 2.5rem;
        }
        .form-select:focus { border-color: hsl(240 5.9% 10%); box-shadow: 0 0 0 2px hsl(240 5.9% 10% / 0.1); }
        .form-label { display: block; font-size: 0.875rem; font-weight: 500; line-height: 1; color: hsl(240 10% 3.9%); margin-bottom: 0.5rem; }
        .btn-primary-shad {
            display: inline-flex; align-items: center; justify-content: center;
            width: 100%; padding: 0.625rem 1rem; font-size: 0.875rem; font-weight: 500;
            line-height: 1.5; color: hsl(0 0% 98%); background-color: hsl(240 5.9% 10%);
            border: 1px solid hsl(240 5.9% 10%); border-radius: 0.5rem; cursor: pointer;
            transition: background-color 0.15s ease;
        }
        .btn-primary-shad:hover { background-color: hsl(240 5.9% 16%); }
        .btn-ghost {
            display: inline-flex; align-items: center; justify-content: center;
            padding: 0.5rem 1rem; font-size: 0.875rem; font-weight: 500;
            color: hsl(240 3.8% 46.1%); background: transparent; border: none;
            border-radius: 0.5rem; cursor: pointer;
            transition: background-color 0.15s ease, color 0.15s ease; text-decoration: none;
        }
        .btn-ghost:hover { background-color: hsl(240 4.8% 95.9%); color: hsl(240 10% 3.9%); }
        textarea.form-input { resize: vertical; min-height: 5rem; }
        .field-validation-error { font-size: 0.8rem; color: hsl(0 84.2% 60.2%); margin-top: 0.25rem; display: block; }
        .input-validation-error { border-color: hsl(0 84.2% 60.2%) !important; }
        .input-validation-error:focus { box-shadow: 0 0 0 2px hsl(0 84.2% 60.2% / 0.2) !important; }
        @@keyframes fadeIn { from { opacity: 0; transform: translateY(0.5rem); } to { opacity: 1; transform: translateY(0); } }
        .animate-in { animation: fadeIn 0.35s ease-out forwards; }
    </style>
</head>
<body class="bg-[hsl(20_14.3%_95.5%)] min-h-screen flex flex-col">
    <!-- Navbar -->
    <header class="w-full border-b border-[hsl(240_5.9%_90%)] bg-white/80 backdrop-blur-sm">
        <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
            <div class="flex items-center gap-2 text-sm font-medium text-[hsl(240_10%_3.9%)]">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                </svg>
                <span class="hidden sm:inline">App Clínica</span>
            </div>
            <nav class="flex items-center gap-1">
                <form asp-controller="CitaMedica" asp-action="Index" method="get" class="m-0">
                    <button type="submit" class="btn-ghost-nav">Mis Citas</button>
                </form>
                <form asp-controller="Usuario" asp-action="Index" method="get" class="m-0">
                    <button type="submit" class="btn-ghost-nav">Perfil</button>
                </form>
                @if (User.Identity.IsAuthenticated && User.IsInRole("2"))
                {
                    <form asp-controller="Notifiacion" asp-action="Index" method="get" class="m-0">
                        <button type="submit" class="btn-ghost-nav">Notificaciones</button>
                    </form>
                }
                <form asp-controller="Login" asp-action="Logout" method="get" class="m-0">
                    <button type="submit" class="btn-ghost-nav">Cerrar sesión</button>
                </form>
            </nav>
        </div>
    </header>

    <main class="flex-1 px-4 py-8">
        <div class="max-w-lg mx-auto animate-in">
            <!-- Header -->
            <div class="text-center mb-8">
                <div class="mx-auto mb-4 w-12 h-12 rounded-xl bg-[hsl(240_5.9%_10%)] flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                        <line x1="16" y1="2" x2="16" y2="6"/>
                        <line x1="8" y1="2" x2="8" y2="6"/>
                        <line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                </div>
                <h1 class="text-xl font-semibold text-[hsl(240_10%_3.9%)] tracking-tight">Agendar Cita Médica</h1>
                <p class="text-sm text-[hsl(240_3.8%_46.1%)] mt-1">Selecciona el médico y la fecha para tu cita</p>
            </div>

            <!-- Validation Summary -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-6 p-3 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">
                    <div class="flex items-start gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0">
                            <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                        </svg>
                        <div>@Html.ValidationSummary(true)</div>
                    </div>
                </div>
            }

            <!-- Form -->
            <div class="bg-white rounded-xl shadow-sm border border-[hsl(240_5.9%_90%)] p-8">
                <form asp-controller="CitaMedica" asp-action="Create" method="post" class="space-y-5">
                    @Html.AntiForgeryToken()

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="IdAfiliado" class="form-label">Paciente</label>
                            <select asp-for="IdAfiliado" class="form-select" asp-items="ViewBag.IdAfiliado">
                                <option value="">Selecciona un paciente</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="IdPersonalMedico" class="form-label">Médico</label>
                            <select asp-for="IdPersonalMedico" class="form-select" asp-items="ViewBag.IdPersonalMedico">
                                <option value="">Selecciona un médico</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label asp-for="FechaCita" class="form-label">Fecha y hora de la cita</label>
                        <input asp-for="FechaCita" class="form-input" type="datetime-local" />
                        <span asp-validation-for="FechaCita"></span>
                    </div>

                    <div>
                        <label asp-for="Estado" class="form-label">Estado</label>
                        <select asp-for="Estado" class="form-select">
                            <option value="">Selecciona un estado</option>
                            <option value="Agendada">Agendada</option>
                            <option value="Completada">Completada</option>
                            <option value="Cancelada">Cancelada</option>
                            <option value="Reprogramada">Reprogramada</option>
                        </select>
                        <span asp-validation-for="Estado"></span>
                    </div>

                    <div>
                        <label asp-for="Comentarios" class="form-label">Comentarios</label>
                        <textarea asp-for="Comentarios" class="form-input" placeholder="Notas adicionales sobre la cita..."></textarea>
                        <span asp-validation-for="Comentarios"></span>
                    </div>

                    <button type="submit" class="btn-primary-shad">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5">
                            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                        Crear cita
                    </button>
                </form>
            </div>

            <!-- Back -->
            <div class="mt-6 text-center">
                <form asp-action="Index" method="get" class="inline">
                    <button type="submit" class="btn-ghost text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline mr-1">
                            <path d="m15 18-6-6 6-6"/>
                        </svg>
                        Volver a mis citas
                    </button>
                </form>
            </div>
        </div>
    </main>

    <footer class="border-t border-[hsl(240_5.9%_90%)] bg-white/50">
        <div class="max-w-5xl mx-auto px-4 h-12 flex items-center justify-center">
            <p class="text-xs text-[hsl(240_3.8%_61%)]">&copy; 2024 App Clínica — Sura EPS</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
