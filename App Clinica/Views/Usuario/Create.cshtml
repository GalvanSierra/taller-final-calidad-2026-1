@model App_Clinica.Models.Usuario
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crear Cuenta — App Clínica</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        border: "hsl(240 5.9% 90%)",
                        input: "hsl(240 5.9% 90%)",
                        ring: "hsl(240 10% 3.9%)",
                        background: "hsl(20 14.3% 95.5%)",
                        foreground: "hsl(240 10% 3.9%)",
                        primary: {
                            DEFAULT: "hsl(240 5.9% 10%)",
                            foreground: "hsl(0 0% 98%)",
                        },
                        muted: {
                            DEFAULT: "hsl(240 4.8% 95.9%)",
                            foreground: "hsl(240 3.8% 46.1%)",
                        },
                        card: {
                            DEFAULT: "hsl(0 0% 100%)",
                            foreground: "hsl(240 10% 3.9%)",
                        },
                    },
                    borderRadius: {
                        lg: "0.5rem",
                        xl: "0.75rem",
                    },
                }
            }
        }
    </script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
        }
        .form-input {
            width: 100%;
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
            line-height: 1.5;
            color: hsl(240 10% 3.9%);
            background-color: hsl(0 0% 100%);
            border: 1px solid hsl(240 5.9% 90%);
            border-radius: 0.5rem;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
            outline: none;
        }
        .form-input:focus {
            border-color: hsl(240 5.9% 10%);
            box-shadow: 0 0 0 2px hsl(240 5.9% 10% / 0.1);
        }
        .form-input::placeholder {
            color: hsl(240 3.8% 61%);
        }
        .form-select {
            width: 100%;
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
            line-height: 1.5;
            color: hsl(240 10% 3.9%);
            background-color: hsl(0 0% 100%);
            border: 1px solid hsl(240 5.9% 90%);
            border-radius: 0.5rem;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
            outline: none;
            appearance: none;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
            background-position: right 0.5rem center;
            background-repeat: no-repeat;
            background-size: 1.5em 1.5em;
            padding-right: 2.5rem;
        }
        .form-select:focus {
            border-color: hsl(240 5.9% 10%);
            box-shadow: 0 0 0 2px hsl(240 5.9% 10% / 0.1);
        }
        .form-label {
            display: block;
            font-size: 0.875rem;
            font-weight: 500;
            line-height: 1;
            color: hsl(240 10% 3.9%);
            margin-bottom: 0.5rem;
        }
        .btn-primary-shad {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 0.625rem 1rem;
            font-size: 0.875rem;
            font-weight: 500;
            line-height: 1.5;
            color: hsl(0 0% 98%);
            background-color: hsl(240 5.9% 10%);
            border: 1px solid hsl(240 5.9% 10%);
            border-radius: 0.5rem;
            cursor: pointer;
            transition: background-color 0.15s ease, opacity 0.15s ease;
        }
        .btn-primary-shad:hover {
            background-color: hsl(240 5.9% 16%);
        }
        .btn-primary-shad:focus-visible {
            outline: none;
            box-shadow: 0 0 0 2px hsl(0 0% 100%), 0 0 0 4px hsl(240 5.9% 10% / 0.3);
        }
        .btn-ghost {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
            font-weight: 500;
            color: hsl(240 3.8% 46.1%);
            background: transparent;
            border: none;
            border-radius: 0.5rem;
            cursor: pointer;
            transition: background-color 0.15s ease, color 0.15s ease;
            text-decoration: none;
        }
        .btn-ghost:hover {
            background-color: hsl(240 4.8% 95.9%);
            color: hsl(240 10% 3.9%);
        }
        .validation-summary-errors ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .validation-summary-errors li {
            font-size: 0.8rem;
            color: hsl(0 84.2% 60.2%);
        }
        .field-validation-error {
            font-size: 0.8rem;
            color: hsl(0 84.2% 60.2%);
            margin-top: 0.25rem;
            display: block;
        }
        .input-validation-error {
            border-color: hsl(0 84.2% 60.2%) !important;
        }
        .input-validation-error:focus {
            box-shadow: 0 0 0 2px hsl(0 84.2% 60.2% / 0.2) !important;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(0.5rem); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-in {
            animation: fadeIn 0.35s ease-out forwards;
        }
    </style>
</head>
<body class="bg-[hsl(20_14.3%_95.5%)] min-h-screen flex items-start justify-center p-4 py-8">
    <div class="w-full max-w-lg animate-in">
        <div class="bg-white rounded-xl shadow-lg border border-[hsl(240_5.9%_90%)] p-8">
            <!-- Header -->
            <div class="text-center mb-8">
                <div class="mx-auto mb-4 w-12 h-12 rounded-xl bg-[hsl(240_5.9%_10%)] flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <line x1="19" y1="8" x2="19" y2="14"/>
                        <line x1="22" y1="11" x2="16" y2="11"/>
                    </svg>
                </div>
                <h1 class="text-xl font-semibold text-[hsl(240_10%_3.9%)] tracking-tight">Crear Cuenta</h1>
                <p class="text-sm text-[hsl(240_3.8%_46.1%)] mt-1">Completa tus datos para registrarte</p>
            </div>

            <!-- Validation Summary -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-6 p-3 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">
                    <div class="flex items-start gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="15" y1="9" x2="9" y2="15"/>
                            <line x1="9" y1="9" x2="15" y2="15"/>
                        </svg>
                        <div>@Html.ValidationSummary(true)</div>
                    </div>
                </div>
            }

            <!-- Form -->
            <form asp-controller="Usuario" asp-action="Create" method="post" class="space-y-5">
                @Html.AntiForgeryToken()

                <!-- Tipo de Usuario -->
                <div>
                    <label asp-for="IdTipoUsuario" class="form-label">Tipo de usuario</label>
                    <select asp-for="IdTipoUsuario" class="form-select" asp-items="ViewBag.IdTipoUsuario">
                        <option value="">Selecciona un tipo</option>
                    </select>
                    <span asp-validation-for="IdTipoUsuario"></span>
                </div>

                <!-- Identificación y Contraseña -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="NumeroIdentificacion" class="form-label">Número de identificación</label>
                        <input asp-for="NumeroIdentificacion" class="form-input" placeholder="Ingresa tu identificación" />
                        <span asp-validation-for="NumeroIdentificacion"></span>
                    </div>
                    <div>
                        <label asp-for="Contraseña" class="form-label">Contraseña</label>
                        <input asp-for="Contraseña" class="form-input" type="password" placeholder="Ingresa tu contraseña" />
                        <span asp-validation-for="Contraseña"></span>
                    </div>
                </div>

                <!-- Nombre y Apellido -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Nombre" class="form-label">Nombre</label>
                        <input asp-for="Nombre" class="form-input" placeholder="Tu nombre" />
                        <span asp-validation-for="Nombre"></span>
                    </div>
                    <div>
                        <label asp-for="Apellido" class="form-label">Apellido</label>
                        <input asp-for="Apellido" class="form-input" placeholder="Tu apellido" />
                        <span asp-validation-for="Apellido"></span>
                    </div>
                </div>

                <!-- Campos condicionales: Especialidad y Disponibilidad -->
                <div id="camposMedico" class="grid grid-cols-1 sm:grid-cols-2 gap-4" style="display:none">
                    <div>
                        <label asp-for="Especialidad" class="form-label">Especialidad</label>
                        <input asp-for="Especialidad" class="form-input" placeholder="Ej: Cardiología" />
                        <span asp-validation-for="Especialidad"></span>
                    </div>
                    <div>
                        <label asp-for="Disponibilidad" class="form-label">Disponibilidad</label>
                        <input asp-for="Disponibilidad" class="form-input" placeholder="Ej: Lunes a Viernes" />
                        <span asp-validation-for="Disponibilidad"></span>
                    </div>
                </div>

                <!-- Email -->
                <div>
                    <label asp-for="Email" class="form-label">Correo electrónico</label>
                    <input asp-for="Email" class="form-input" type="email" placeholder="correo@ejemplo.com" />
                    <span asp-validation-for="Email"></span>
                </div>

                <!-- Teléfono -->
                <div>
                    <label asp-for="Telefono" class="form-label">Teléfono</label>
                    <input asp-for="Telefono" class="form-input" placeholder="Ej: 3001234567" />
                    <span asp-validation-for="Telefono"></span>
                </div>

                <button type="submit" class="btn-primary-shad">
                    Crear cuenta
                </button>
            </form>

            <!-- Footer links -->
            <div class="mt-6 text-center">
                <form asp-controller="Login" asp-action="login" method="get" class="inline">
                    <button type="submit" class="btn-ghost text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline mr-1">
                            <path d="m15 18-6-6 6-6"/>
                        </svg>
                        Volver a iniciar sesión
                    </button>
                </form>
            </div>
        </div>
        <p class="text-center text-xs text-[hsl(240_3.8%_61%)] mt-6">
            &copy; 2024 App Clínica
        </p>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const select = document.getElementById("IdTipoUsuario");
            const camposMedico = document.getElementById("camposMedico");
            const especialidad = document.getElementById("Especialidad");
            const disponibilidad = document.getElementById("Disponibilidad");

            function toggleCampos() {
                if (select.value === "2") {
                    camposMedico.style.display = "grid";
                    especialidad.disabled = false;
                    disponibilidad.disabled = false;
                } else {
                    camposMedico.style.display = "none";
                    especialidad.disabled = true;
                    disponibilidad.disabled = true;
                }
            }

            toggleCampos();
            select.addEventListener("change", toggleCampos);
        });
    </script>
</body>
</html>
