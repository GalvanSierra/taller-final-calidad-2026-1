@model App_Clinica.Models.Usuario
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Detalle de Usuario — App Clínica</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        border: "hsl(240 5.9% 90%)",
                        background: "hsl(20 14.3% 95.5%)",
                        foreground: "hsl(240 10% 3.9%)",
                        primary: { DEFAULT: "hsl(240 5.9% 10%)", foreground: "hsl(0 0% 98%)" },
                        muted: { DEFAULT: "hsl(240 4.8% 95.9%)", foreground: "hsl(240 3.8% 46.1%)" },
                        card: { DEFAULT: "hsl(0 0% 100%)", foreground: "hsl(240 10% 3.9%)" },
                        destructive: { DEFAULT: "hsl(0 84.2% 60.2%)", foreground: "hsl(0 0% 98%)" },
                    },
                    borderRadius: { lg: "0.5rem", xl: "0.75rem" },
                }
            }
        }
    </script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif; }
        .btn-ghost-nav {
            display: inline-flex; align-items: center; justify-content: center;
            padding: 0.5rem 0.75rem; font-size: 0.8125rem; font-weight: 500;
            color: hsl(240 3.8% 46.1%); background: transparent; border: none;
            border-radius: 0.375rem; cursor: pointer; transition: background-color 0.15s ease, color 0.15s ease;
            text-decoration: none;
        }
        .btn-ghost-nav:hover { background-color: hsl(240 4.8% 95.9%); color: hsl(240 10% 3.9%); }
        .btn-primary-sm {
            display: inline-flex; align-items: center; justify-content: center; gap: 0.375rem;
            padding: 0.5rem 1rem; font-size: 0.8125rem; font-weight: 500;
            color: hsl(0 0% 98%); background-color: hsl(240 5.9% 10%);
            border: 1px solid hsl(240 5.9% 10%); border-radius: 0.5rem;
            cursor: pointer; transition: background-color 0.15s ease; text-decoration: none;
        }
        .btn-primary-sm:hover { background-color: hsl(240 5.9% 16%); }
        .btn-outline {
            display: inline-flex; align-items: center; justify-content: center; gap: 0.25rem;
            padding: 0.375rem 0.75rem; font-size: 0.75rem; font-weight: 500;
            color: hsl(240 10% 3.9%); background: transparent;
            border: 1px solid hsl(240 5.9% 90%); border-radius: 0.375rem;
            cursor: pointer; transition: background-color 0.15s ease; text-decoration: none;
        }
        .btn-outline:hover { background-color: hsl(240 4.8% 95.9%); }
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(0.5rem); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-in { animation: fadeIn 0.35s ease-out forwards; }
    </style>
</head>
<body class="bg-[hsl(20_14.3%_95.5%)] min-h-screen flex flex-col">
    <header class="w-full border-b border-[hsl(240_5.9%_90%)] bg-white/80 backdrop-blur-sm">
        <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
            <div class="flex items-center gap-2 text-sm font-medium text-[hsl(240_10%_3.9%)]">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                <span class="hidden sm:inline">App Clínica</span>
            </div>
            <nav class="flex items-center gap-1">
                <form asp-controller="CitaMedica" asp-action="Index" method="get" class="m-0">
                    <button type="submit" class="btn-ghost-nav">Mis Citas</button>
                </form>
                <form asp-controller="Usuario" asp-action="Index" method="get" class="m-0">
                    <button type="submit" class="btn-ghost-nav">Perfil</button>
                </form>
                <form asp-controller="Login" asp-action="Logout" method="get" class="m-0">
                    <button type="submit" class="btn-ghost-nav">Cerrar sesión</button>
                </form>
            </nav>
        </div>
    </header>

    <main class="flex-1 px-4 py-8">
        <div class="max-w-2xl mx-auto animate-in">
            <div class="mb-6">
                <h1 class="text-lg font-semibold text-[hsl(240_10%_3.9%)]">Detalle de Usuario</h1>
            </div>

            <div class="bg-white rounded-xl shadow-sm border border-[hsl(240_5.9%_90%)] divide-y divide-[hsl(240_5.9%_90%)]">
                <div class="px-6 py-4 flex items-center justify-between">
                    <span class="text-sm font-medium text-[hsl(240_3.8%_46.1%)]">Identificación</span>
                    <span class="text-sm text-[hsl(240_10%_3.9%)]">@Model.NumeroIdentificacion</span>
                </div>
                <div class="px-6 py-4 flex items-center justify-between">
                    <span class="text-sm font-medium text-[hsl(240_3.8%_46.1%)]">Nombre</span>
                    <span class="text-sm text-[hsl(240_10%_3.9%)]">@Model.Nombre @Model.Apellido</span>
                </div>
                <div class="px-6 py-4 flex items-center justify-between">
                    <span class="text-sm font-medium text-[hsl(240_3.8%_46.1%)]">Email</span>
                    <span class="text-sm text-[hsl(240_10%_3.9%)]">@Model.Email</span>
                </div>
                <div class="px-6 py-4 flex items-center justify-between">
                    <span class="text-sm font-medium text-[hsl(240_3.8%_46.1%)]">Teléfono</span>
                    <span class="text-sm text-[hsl(240_10%_3.9%)]">@Model.Telefono</span>
                </div>
                <div class="px-6 py-4 flex items-center justify-between">
                    <span class="text-sm font-medium text-[hsl(240_3.8%_46.1%)]">Fecha de registro</span>
                    <span class="text-sm text-[hsl(240_10%_3.9%)]">@Model.FechaRegistro?.ToString("dd/MM/yyyy")</span>
                </div>
                @if (User.Identity.IsAuthenticated && User.IsInRole("2"))
                {
                    <div class="px-6 py-4 flex items-center justify-between">
                        <span class="text-sm font-medium text-[hsl(240_3.8%_46.1%)]">Especialidad</span>
                        <span class="text-sm text-[hsl(240_10%_3.9%)]">@Model.Especialidad</span>
                    </div>
                    <div class="px-6 py-4 flex items-center justify-between">
                        <span class="text-sm font-medium text-[hsl(240_3.8%_46.1%)]">Disponibilidad</span>
                        <span class="text-sm text-[hsl(240_10%_3.9%)]">@Model.Disponibilidad</span>
                    </div>
                }
            </div>

            <div class="mt-6 flex items-center justify-between">
                <form asp-action="Edit" asp-route-id="@Model.IdUsuario" method="get" class="m-0 inline">
                    <button type="submit" class="btn-primary-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                        Editar
                    </button>
                </form>
                <form asp-action="Index" method="get" class="m-0 inline">
                    <button type="submit" class="btn-ghost-nav text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline mr-1"><path d="m15 18-6-6 6-6"/></svg>
                        Volver
                    </button>
                </form>
            </div>
        </div>
    </main>

    <footer class="border-t border-[hsl(240_5.9%_90%)] bg-white/50">
        <div class="max-w-5xl mx-auto px-4 h-12 flex items-center justify-center">
            <p class="text-xs text-[hsl(240_3.8%_61%)]">&copy; 2024 App Clínica — Sura EPS</p>
        </div>
    </footer>
</body>
</html>
