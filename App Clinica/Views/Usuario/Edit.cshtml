@model App_Clinica.Models.Usuario
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Editar Perfil — App Clínica</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        border: "hsl(240 5.9% 90%)",
                        background: "hsl(20 14.3% 95.5%)",
                        foreground: "hsl(240 10% 3.9%)",
                        primary: { DEFAULT: "hsl(240 5.9% 10%)", foreground: "hsl(0 0% 98%)" },
                        muted: { DEFAULT: "hsl(240 4.8% 95.9%)", foreground: "hsl(240 3.8% 46.1%)" },
                        card: { DEFAULT: "hsl(0 0% 100%)", foreground: "hsl(240 10% 3.9%)" },
                        destructive: { DEFAULT: "hsl(0 84.2% 60.2%)", foreground: "hsl(0 0% 98%)" },
                    },
                    borderRadius: { lg: "0.5rem", xl: "0.75rem" },
                }
            }
        }
    </script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif; }
        .btn-ghost-nav {
            display: inline-flex; align-items: center; justify-content: center;
            padding: 0.5rem 0.75rem; font-size: 0.8125rem; font-weight: 500;
            color: hsl(240 3.8% 46.1%); background: transparent; border: none;
            border-radius: 0.375rem; cursor: pointer; transition: background-color 0.15s ease, color 0.15s ease;
            text-decoration: none;
        }
        .btn-ghost-nav:hover { background-color: hsl(240 4.8% 95.9%); color: hsl(240 10% 3.9%); }
        .btn-primary-sm {
            display: inline-flex; align-items: center; justify-content: center; gap: 0.375rem;
            padding: 0.5rem 1rem; font-size: 0.8125rem; font-weight: 500;
            color: hsl(0 0% 98%); background-color: hsl(240 5.9% 10%);
            border: 1px solid hsl(240 5.9% 10%); border-radius: 0.5rem;
            cursor: pointer; transition: background-color 0.15s ease; text-decoration: none;
        }
        .btn-primary-sm:hover { background-color: hsl(240 5.9% 16%); }
        .form-input {
            width: 100%; padding: 0.5rem 0.75rem; font-size: 0.875rem; line-height: 1.25rem;
            color: hsl(240 10% 3.9%); background-color: hsl(0 0% 100%);
            border: 1px solid hsl(240 5.9% 90%); border-radius: 0.375rem;
            outline: none; transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }
        .form-input:focus { border-color: hsl(240 5.9% 10%); box-shadow: 0 0 0 2px hsl(240 5.9% 90%); }
        .form-label { display: block; font-size: 0.8125rem; font-weight: 500; color: hsl(240 10% 3.9%); margin-bottom: 0.375rem; }
        .field-validation-error { display: block; font-size: 0.75rem; color: hsl(0 84.2% 60.2%); margin-top: 0.25rem; }
        .validation-summary-errors { font-size: 0.8125rem; color: hsl(0 84.2% 60.2%); }
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(0.5rem); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-in { animation: fadeIn 0.35s ease-out forwards; }
    </style>
</head>
<body class="bg-[hsl(20_14.3%_95.5%)] min-h-screen flex flex-col">
    <header class="w-full border-b border-[hsl(240_5.9%_90%)] bg-white/80 backdrop-blur-sm">
        <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
            <div class="flex items-center gap-2 text-sm font-medium text-[hsl(240_10%_3.9%)]">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                <span class="hidden sm:inline">App Clínica</span>
            </div>
            <nav class="flex items-center gap-1">
                <form asp-controller="CitaMedica" asp-action="Index" method="get" class="m-0">
                    <button type="submit" class="btn-ghost-nav">Mis Citas</button>
                </form>
                <form asp-controller="Usuario" asp-action="Index" method="get" class="m-0">
                    <button type="submit" class="btn-ghost-nav">Perfil</button>
                </form>
                <form asp-controller="Login" asp-action="Logout" method="get" class="m-0">
                    <button type="submit" class="btn-ghost-nav">Cerrar sesión</button>
                </form>
            </nav>
        </div>
    </header>

    <main class="flex-1 px-4 py-8">
        <div class="max-w-lg mx-auto animate-in">
            <div class="mb-6">
                <h1 class="text-lg font-semibold text-[hsl(240_10%_3.9%)]">Editar Perfil</h1>
                <p class="text-sm text-[hsl(240_3.8%_46.1%)] mt-0.5">Actualiza tus datos personales</p>
            </div>

            <div class="bg-white rounded-xl shadow-sm border border-[hsl(240_5.9%_90%)] p-6">
                <form asp-controller="Usuario" asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-4"></div>
                    <input type="hidden" asp-for="IdUsuario" />

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="NumeroIdentificacion" class="form-label"></label>
                            <input asp-for="NumeroIdentificacion" class="form-input" />
                            <span asp-validation-for="NumeroIdentificacion" class="field-validation-error"></span>
                        </div>
                        <div>
                            <label asp-for="Contraseña" class="form-label"></label>
                            <input asp-for="Contraseña" type="password" class="form-input" />
                            <span asp-validation-for="Contraseña" class="field-validation-error"></span>
                        </div>
                        <div>
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-input" />
                            <span asp-validation-for="Nombre" class="field-validation-error"></span>
                        </div>
                        <div>
                            <label asp-for="Apellido" class="form-label"></label>
                            <input asp-for="Apellido" class="form-input" />
                            <span asp-validation-for="Apellido" class="field-validation-error"></span>
                        </div>
                        <div>
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" type="email" class="form-input" />
                            <span asp-validation-for="Email" class="field-validation-error"></span>
                        </div>
                        <div>
                            <label asp-for="Telefono" class="form-label"></label>
                            <input asp-for="Telefono" class="form-input" />
                            <span asp-validation-for="Telefono" class="field-validation-error"></span>
                        </div>
                        @if (User.Identity.IsAuthenticated && User.IsInRole("2"))
                        {
                            <div>
                                <label asp-for="Especialidad" class="form-label"></label>
                                <input asp-for="Especialidad" class="form-input" />
                                <span asp-validation-for="Especialidad" class="field-validation-error"></span>
                            </div>
                            <div>
                                <label asp-for="Disponibilidad" class="form-label"></label>
                                <input asp-for="Disponibilidad" class="form-input" />
                                <span asp-validation-for="Disponibilidad" class="field-validation-error"></span>
                            </div>
                        }
                    </div>

                    <div class="hidden">
                        <label asp-for="FechaRegistro" class="form-label"></label>
                        <input asp-for="FechaRegistro" class="form-input" />
                        <span asp-validation-for="FechaRegistro" class="field-validation-error"></span>
                    </div>

                    <div class="flex items-center justify-between mt-6">
                        <button type="submit" class="btn-primary-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                            Guardar cambios
                        </button>
                        <form asp-action="Index" method="get" class="m-0 inline">
                            <button type="submit" class="btn-ghost-nav text-sm">Cancelar</button>
                        </form>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <footer class="border-t border-[hsl(240_5.9%_90%)] bg-white/50">
        <div class="max-w-5xl mx-auto px-4 h-12 flex items-center justify-center">
            <p class="text-xs text-[hsl(240_3.8%_61%)]">&copy; 2024 App Clínica — Sura EPS</p>
        </div>
    </footer>

    <script src="https://ajax.aspnetcdn.com/ajax/jquery/jquery-3.6.0.min.js"></script>
    <script src="https://ajax.aspnetcdn.com/ajax/jquery.validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://ajax.aspnetcdn.com/ajax/mvc/5.2.3/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
