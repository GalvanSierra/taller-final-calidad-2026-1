@model App_Clinica.Models.Usuario
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mi Perfil — App Clínica</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        border: "hsl(240 5.9% 90%)",
                        background: "hsl(20 14.3% 95.5%)",
                        foreground: "hsl(240 10% 3.9%)",
                        primary: {
                            DEFAULT: "hsl(240 5.9% 10%)",
                            foreground: "hsl(0 0% 98%)",
                        },
                        muted: {
                            DEFAULT: "hsl(240 4.8% 95.9%)",
                            foreground: "hsl(240 3.8% 46.1%)",
                        },
                        card: {
                            DEFAULT: "hsl(0 0% 100%)",
                            foreground: "hsl(240 10% 3.9%)",
                        },
                        destructive: {
                            DEFAULT: "hsl(0 84.2% 60.2%)",
                            foreground: "hsl(0 0% 98%)",
                        },
                    },
                    borderRadius: {
                        lg: "0.5rem",
                        xl: "0.75rem",
                    },
                }
            }
        }
    </script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
        }
        .btn-ghost {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
            font-weight: 500;
            color: hsl(240 3.8% 46.1%);
            background: transparent;
            border: 1px solid hsl(240 5.9% 90%);
            border-radius: 0.5rem;
            cursor: pointer;
            transition: background-color 0.15s ease, color 0.15s ease;
            text-decoration: none;
        }
        .btn-ghost:hover {
            background-color: hsl(240 4.8% 95.9%);
            color: hsl(240 10% 3.9%);
        }
        .btn-outline {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.375rem;
            padding: 0.5rem 1rem;
            font-size: 0.8125rem;
            font-weight: 500;
            color: hsl(240 10% 3.9%);
            background: transparent;
            border: 1px solid hsl(240 5.9% 90%);
            border-radius: 0.5rem;
            cursor: pointer;
            transition: background-color 0.15s ease;
            text-decoration: none;
        }
        .btn-outline:hover {
            background-color: hsl(240 4.8% 95.9%);
        }
        .btn-destructive {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.375rem;
            padding: 0.5rem 1rem;
            font-size: 0.8125rem;
            font-weight: 500;
            color: hsl(0 0% 98%);
            background-color: hsl(0 84.2% 60.2%);
            border: 1px solid hsl(0 84.2% 60.2%);
            border-radius: 0.5rem;
            cursor: pointer;
            transition: background-color 0.15s ease;
            text-decoration: none;
        }
        .btn-destructive:hover {
            background-color: hsl(0 72% 51%);
        }
        .btn-destructive:focus-visible {
            outline: none;
            box-shadow: 0 0 0 2px hsl(0 0% 100%), 0 0 0 4px hsl(0 84.2% 60.2% / 0.3);
        }
        .btn-primary-sm {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.375rem;
            padding: 0.5rem 1rem;
            font-size: 0.8125rem;
            font-weight: 500;
            color: hsl(0 0% 98%);
            background-color: hsl(240 5.9% 10%);
            border: 1px solid hsl(240 5.9% 10%);
            border-radius: 0.5rem;
            cursor: pointer;
            transition: background-color 0.15s ease;
            text-decoration: none;
        }
        .btn-primary-sm:hover {
            background-color: hsl(240 5.9% 16%);
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(0.5rem); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-in {
            animation: fadeIn 0.35s ease-out forwards;
        }
    </style>
</head>
<body class="bg-[hsl(20_14.3%_95.5%)] min-h-screen flex flex-col">
    <!-- Navbar -->
    <header class="w-full border-b border-[hsl(240_5.9%_90%)] bg-white/80 backdrop-blur-sm">
        <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
            <div class="flex items-center gap-2 text-sm font-medium text-[hsl(240_10%_3.9%)]">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                </svg>
                <span class="hidden sm:inline">App Clínica</span>
            </div>
            <nav class="flex items-center gap-1">
                <form asp-controller="CitaMedica" asp-action="Create" method="get" class="m-0">
                    <button type="submit" class="btn-ghost text-sm px-3 py-1.5">Nueva Cita</button>
                </form>
                <form asp-controller="CitaMedica" asp-action="Index" method="get" class="m-0">
                    <button type="submit" class="btn-ghost text-sm px-3 py-1.5">Mis Citas</button>
                </form>
                @if (User.Identity.IsAuthenticated && User.IsInRole("2"))
                {
                    <form asp-controller="Notifiacion" asp-action="Index" method="get" class="m-0">
                        <button type="submit" class="btn-ghost text-sm px-3 py-1.5">Notificaciones</button>
                    </form>
                }
                <form asp-controller="Login" asp-action="Logout" method="get" class="m-0">
                    <button type="submit" class="btn-ghost text-sm px-3 py-1.5">Cerrar sesión</button>
                </form>
            </nav>
        </div>
    </header>

    <!-- Main -->
    <main class="flex-1 px-4 py-8">
        <div class="max-w-2xl mx-auto animate-in">
            <!-- Header -->
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-full bg-[hsl(240_5.9%_10%)] flex items-center justify-center text-white text-sm font-semibold">
                    @(Model.Nombre?.First().ToString() ?? "?")
                </div>
                <div>
                    <h1 class="text-lg font-semibold text-[hsl(240_10%_3.9%)]">@Model.Nombre @Model.Apellido</h1>
                    <p class="text-sm text-[hsl(240_3.8%_46.1%)]">@Model.IdTipoUsuarioNavigation?.NombreTipo</p>
                </div>
            </div>

            <!-- Profile Card -->
            <div class="bg-white rounded-xl shadow-sm border border-[hsl(240_5.9%_90%)] divide-y divide-[hsl(240_5.9%_90%)]">
                <!-- Identificación -->
                <div class="flex items-center justify-between px-6 py-4">
                    <span class="text-sm text-[hsl(240_3.8%_46.1%)]">Identificación</span>
                    <span class="text-sm font-medium text-[hsl(240_10%_3.9%)]">@Model.NumeroIdentificacion</span>
                </div>

                <!-- Nombre completo -->
                <div class="flex items-center justify-between px-6 py-4">
                    <span class="text-sm text-[hsl(240_3.8%_46.1%)]">Nombre completo</span>
                    <span class="text-sm font-medium text-[hsl(240_10%_3.9%)]">@Model.Nombre @Model.Apellido</span>
                </div>

                <!-- Email -->
                <div class="flex items-center justify-between px-6 py-4">
                    <span class="text-sm text-[hsl(240_3.8%_46.1%)]">Correo electrónico</span>
                    <span class="text-sm font-medium text-[hsl(240_10%_3.9%)]">@Model.Email</span>
                </div>

                <!-- Teléfono -->
                <div class="flex items-center justify-between px-6 py-4">
                    <span class="text-sm text-[hsl(240_3.8%_46.1%)]">Teléfono</span>
                    <span class="text-sm font-medium text-[hsl(240_10%_3.9%)]">@Model.Telefono</span>
                </div>

                <!-- Especialidad (solo para rol 2) -->
                @if (User.Identity.IsAuthenticated && User.IsInRole("2"))
                {
                    <div class="flex items-center justify-between px-6 py-4">
                        <span class="text-sm text-[hsl(240_3.8%_46.1%)]">Especialidad</span>
                        <span class="text-sm font-medium text-[hsl(240_10%_3.9%)]">@(Model.Especialidad ?? "—")</span>
                    </div>
                    <div class="flex items-center justify-between px-6 py-4">
                        <span class="text-sm text-[hsl(240_3.8%_46.1%)]">Disponibilidad</span>
                        <span class="text-sm font-medium text-[hsl(240_10%_3.9%)]">@(Model.Disponibilidad ?? "—")</span>
                    </div>
                }
            </div>

            <!-- Actions -->
            <div class="mt-6 flex flex-wrap gap-2">
                <form asp-action="Edit" asp-route-id="@Model.IdUsuario" method="get" class="m-0">
                    <button type="submit" class="btn-outline">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                        </svg>
                        Editar perfil
                    </button>
                </form>
                <form asp-action="Details" asp-route-id="@Model.IdUsuario" method="get" class="m-0">
                    <button type="submit" class="btn-outline">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 16v-4"/>
                            <path d="M12 8h.01"/>
                        </svg>
                        Ver detalles
                    </button>
                </form>
                @if (User.Identity.IsAuthenticated && User.IsInRole("2"))
                {
                    <form asp-action="Delete" asp-route-id="@Model.IdUsuario" method="post" class="m-0">
                        <button type="submit" class="btn-destructive">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 6h18"/>
                                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                            </svg>
                            Eliminar cuenta
                        </button>
                    </form>
                }
            </div>

            <!-- Back link -->
            <div class="mt-8 text-center">
                <form asp-controller="Usuario" asp-action="Inicio" method="get" class="inline">
                    <button type="submit" class="btn-ghost text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline mr-1">
                            <path d="m15 18-6-6 6-6"/>
                        </svg>
                        Volver al inicio
                    </button>
                </form>
            </div>
        </div>
    </main>

    <footer class="border-t border-[hsl(240_5.9%_90%)] bg-white/50">
        <div class="max-w-5xl mx-auto px-4 h-12 flex items-center justify-center">
            <p class="text-xs text-[hsl(240_3.8%_61%)]">&copy; 2024 App Clínica — Sura EPS</p>
        </div>
    </footer>
</body>
</html>
