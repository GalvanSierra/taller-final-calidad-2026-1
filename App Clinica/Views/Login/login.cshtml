@model App_Clinica.Models.Login
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión — App Clínica</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        border: "hsl(240 5.9% 90%)",
                        input: "hsl(240 5.9% 90%)",
                        ring: "hsl(240 10% 3.9%)",
                        background: "hsl(20 14.3% 95.5%)",
                        foreground: "hsl(240 10% 3.9%)",
                        primary: {
                            DEFAULT: "hsl(240 5.9% 10%)",
                            foreground: "hsl(0 0% 98%)",
                        },
                        muted: {
                            DEFAULT: "hsl(240 4.8% 95.9%)",
                            foreground: "hsl(240 3.8% 46.1%)",
                        },
                        card: {
                            DEFAULT: "hsl(0 0% 100%)",
                            foreground: "hsl(240 10% 3.9%)",
                        },
                    },
                    borderRadius: {
                        lg: "0.5rem",
                        xl: "0.75rem",
                    },
                }
            }
        }
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
        }
        .form-input {
            width: 100%;
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
            line-height: 1.5;
            color: hsl(240 10% 3.9%);
            background-color: hsl(0 0% 100%);
            border: 1px solid hsl(240 5.9% 90%);
            border-radius: 0.5rem;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
            outline: none;
        }
        .form-input:focus {
            border-color: hsl(240 5.9% 10%);
            box-shadow: 0 0 0 2px hsl(240 5.9% 10% / 0.1);
        }
        .form-input::placeholder {
            color: hsl(240 3.8% 61%);
        }
        .form-label {
            display: block;
            font-size: 0.875rem;
            font-weight: 500;
            line-height: 1;
            color: hsl(240 10% 3.9%);
            margin-bottom: 0.5rem;
        }
        .btn-primary-shad {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 0.625rem 1rem;
            font-size: 0.875rem;
            font-weight: 500;
            line-height: 1.5;
            color: hsl(0 0% 98%);
            background-color: hsl(240 5.9% 10%);
            border: 1px solid hsl(240 5.9% 10%);
            border-radius: 0.5rem;
            cursor: pointer;
            transition: background-color 0.15s ease, opacity 0.15s ease;
        }
        .btn-primary-shad:hover {
            background-color: hsl(240 5.9% 16%);
        }
        .btn-primary-shad:focus-visible {
            outline: none;
            box-shadow: 0 0 0 2px hsl(0 0% 100%), 0 0 0 4px hsl(240 5.9% 10% / 0.3);
        }
        .btn-ghost {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
            font-weight: 500;
            color: hsl(240 3.8% 46.1%);
            background: transparent;
            border: none;
            border-radius: 0.5rem;
            cursor: pointer;
            transition: background-color 0.15s ease, color 0.15s ease;
            text-decoration: none;
        }
        .btn-ghost:hover {
            background-color: hsl(240 4.8% 95.9%);
            color: hsl(240 10% 3.9%);
        }
        .validation-summary-errors ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .validation-summary-errors li {
            font-size: 0.8rem;
            color: hsl(0 84.2% 60.2%);
        }
        .field-validation-error {
            font-size: 0.8rem;
            color: hsl(0 84.2% 60.2%);
            margin-top: 0.25rem;
            display: block;
        }
        .input-validation-error {
            border-color: hsl(0 84.2% 60.2%) !important;
        }
        .input-validation-error:focus {
            box-shadow: 0 0 0 2px hsl(0 84.2% 60.2% / 0.2) !important;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(0.5rem); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-in {
            animation: fadeIn 0.35s ease-out forwards;
        }
    </style>
</head>
<body class="bg-[hsl(20_14.3%_95.5%)] min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-sm animate-in">
        <div class="bg-white rounded-xl shadow-lg border border-[hsl(240_5.9%_90%)] p-8">
            <!-- Header -->
            <div class="text-center mb-8">
                <div class="mx-auto mb-4 w-12 h-12 rounded-xl bg-[hsl(240_5.9%_10%)] flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                    </svg>
                </div>
                <h1 class="text-xl font-semibold text-[hsl(240_10%_3.9%)] tracking-tight">Iniciar Sesión</h1>
                <p class="text-sm text-[hsl(240_3.8%_46.1%)] mt-1">Ingresa tus credenciales para acceder</p>
            </div>

            <!-- Validation Summary -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-6 p-3 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">
                    <div class="flex items-start gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="15" y1="9" x2="9" y2="15"/>
                            <line x1="9" y1="9" x2="15" y2="15"/>
                        </svg>
                        <div>@Html.ValidationSummary(true)</div>
                    </div>
                </div>
            }

            <!-- Form -->
            <form asp-controller="Login" asp-action="login" method="post" class="space-y-5">
                <div>
                    <label asp-for="NumeroIdentificacion" class="form-label">Número de identificación</label>
                    <input asp-for="NumeroIdentificacion" class="form-input" placeholder="Ingresa tu identificación" autocomplete="username" />
                    <span asp-validation-for="NumeroIdentificacion"></span>
                </div>

                <div>
                    <label asp-for="Contraseña" class="form-label">Contraseña</label>
                    <input asp-for="Contraseña" class="form-input" type="password" placeholder="Ingresa tu contraseña" autocomplete="current-password" />
                    <span asp-validation-for="Contraseña"></span>
                </div>

                <button type="submit" class="btn-primary-shad">
                    Iniciar Sesión
                </button>
            </form>

            <!-- Footer links -->
            <div class="mt-6 space-y-2 text-center">
                <form asp-controller="Usuario" asp-action="Create" method="get" class="inline">
                    <button type="submit" class="btn-ghost text-sm gap-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <line x1="19" y1="8" x2="19" y2="14"/>
                            <line x1="22" y1="11" x2="16" y2="11"/>
                        </svg>
                        Crear cuenta
                    </button>
                </form>
                <div>
                    <form asp-controller="Usuario" asp-action="Inicio" method="get" class="inline">
                        <button type="submit" class="btn-ghost text-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline mr-1">
                                <path d="m15 18-6-6 6-6"/>
                            </svg>
                            Regresar
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <p class="text-center text-xs text-[hsl(240_3.8%_61%)] mt-6">
            &copy; 2024 App Clínica
        </p>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
